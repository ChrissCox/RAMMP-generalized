<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rammp_adl_runtime</name>
  <version>0.1.0</version>
  <description>Simulation-only ROS composition of the reusable ADL autonomy runtime.</description>
  <maintainer email="maintainers@example.invalid">RAMMP maintainers</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rammp_adl_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend version_gte="4.22">python3-jsonschema</exec_depend>
  <exec_depend version_gte="1.26">python3-numpy</exec_depend>
  <!-- Cloud/camera/physics extras follow the root pyproject optional dependencies.
       They are not installed implicitly by launching the fixture executor. -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
