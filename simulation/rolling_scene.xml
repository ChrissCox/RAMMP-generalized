<mujoco model="Gen3 rolling fixture">
  <include file="vendor/kinova_gen3/gen3.xml"/>
  <compiler meshdir="vendor/kinova_gen3/assets"/>
  <contact>
    <!-- The upstream fixed-base mesh overlaps its directly adjacent shoulder.
         This explicit simulation pair exclusion removes an artificial contact;
         it is not a deployed robot collision configuration. -->
    <exclude body1="base_link" body2="shoulder_link"/>
  </contact>
  <worldbody>
    <light pos="0 -1 2"/>
    <geom name="floor" type="plane" size="2 2 0.05" rgba="0.25 0.3 0.35 1"/>
  </worldbody>
</mujoco>
